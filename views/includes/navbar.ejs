<div class="nav-floating-wrapper <%= (['/home', '/login', '/signup'].includes(path) || currentUser) ? 'home-navbar-active' : '' %>">
  <nav class="navbar navbar-expand-lg glass-pill-nav animate-in">
    <div class="container-fluid px-3 px-md-4">
      <!-- Logo -->
      <a class="navbar-brand d-flex align-items-center" href="/home">
        <div class="logo-icon-box me-2">
          <i class="fa-solid fa-compass" style="color: #fe424d;"></i>
        </div>

      </a>

      <!-- Desktop Search (Always visible except on home/auth pages as requested) -->
      <% if (!['/home', '/login', '/signup'].includes(path)) { %>
      <form class="search-pill-container d-none d-xl-flex mx-auto" action="/listings" method="GET">
        <input class="search-input-pill" type="search" name="search" placeholder="Search destinations...">
        <button class="search-btn-pill" type="submit"><i class="fa-solid fa-magnifying-glass"></i></button>
      </form>
      <% } else { %>
      <!-- Spacer -->
      <div class="mx-auto d-none d-xl-flex"></div>
      <% } %>

      <!-- Mobile Toggle (Three Dots) -->
      <button class="mobile-more-btn d-lg-none" type="button" data-bs-toggle="collapse" data-bs-target="#floatingNavContent">
        <i class="fa-solid fa-ellipsis-vertical"></i>
      </button>

      <div class="collapse navbar-collapse justify-content-end" id="floatingNavContent">
        <!-- Mobile Search -->
        <% if (!['/home', '/login', '/signup'].includes(path)) { %>
        <form class="search-pill-container d-flex d-xl-none mb-3 mt-2 mx-auto w-100" action="/listings" method="GET">
          <input class="search-input-pill" type="search" name="search" placeholder="Search destinations...">
          <button class="search-btn-pill" type="submit"><i class="fa-solid fa-magnifying-glass"></i></button>
        </form>
        <% } %>

        <div class="navbar-nav align-items-lg-center">
          <a class="nav-link nav-pill-link" href="/listings">Explore</a>
          <a class="nav-link nav-pill-link" href="/listings/new">Add Listing</a>
          
          <% if(currentUser) { %>
            <span class="nav-separator mx-2 d-none d-lg-inline" style="color: #ccc; opacity: 0.6;">|</span>
            <a class="nav-link nav-pill-link" href="/favorites">Favorites</a>
            <div class="nav-item dropdown d-none d-lg-block">
              <a class="nav-link dropdown-toggle user-pill-btn ms-lg-3" href="#" id="userDrop" role="button" data-bs-toggle="dropdown">
                <i class="fa-solid fa-circle-user me-2"></i><%= currentUser.username %>
              </a>
              <ul class="dropdown-menu dropdown-menu-end glass-pill-dropdown mt-3 border-0 shadow-lg">
                <li><a class="dropdown-item py-2" href="/settings"><i class="fa-solid fa-gear me-2 text-muted"></i>Settings</a></li>
                <li><hr class="dropdown-divider opacity-50"></li>
                <li><a class="dropdown-item py-2 text-danger" href="/logout"><i class="fa-solid fa-power-off me-2"></i>Logout</a></li>
              </ul>
            </div>
            <!-- Mobile Auth Links -->
            <a class="nav-link nav-pill-link d-lg-none" href="/settings">Settings</a>
            <a class="nav-link nav-pill-link d-lg-none text-danger" href="/logout">Logout</a>
          <% } else { %>
            <span class="nav-separator mx-2 d-none d-lg-inline" style="color: #ccc; opacity: 0.6;">|</span>
            <a class="nav-link login-pill-link mx-lg-3" href="/login">Login</a>
            <a class="nav-link signup-pill-btn" href="/signup">Get Started</a>
          <% } %>
        </div>
      </div>
    </div>
  </nav>
</div>
