<%- layout("/layouts/boilerplate") %>

<div class="row mt-3">
    <h2 class="col-lg-4 offset-lg-4 col-md-6 offset-md-3 col-10 offset-1 login-title">Forgot Password</h2>
    <div class="col-lg-4 offset-lg-4 col-md-6 offset-md-3 col-10 offset-1 login-container">
        <form action="/forgot-password" method="POST" class="needs-validation" novalidate>
            <div class="mb-3">
                <label for="email" class="form-label">Email</label>
                <input name="email" id="email" type="email" class="form-control" required>
                <div class="invalid-feedback">
                    Please provide a valid email.
                </div>
            </div>
            <button class="btn btn-primary sign-btn">Continue</button>
        </form>
    </div>
</div>
<p class="col-lg-4 offset-lg-4 col-md-6 offset-md-3 col-10 offset-1 mb-3 mt-3 login-link">Remember your password? <a href="/login">Login</a></p>
